# ============================================================================
# Helix — environment configuration
# ============================================================================
# Copy to .env and fill in what you need. Everything here has a working
# default for local development, so a fresh clone runs with an empty .env.
#
# Nothing in the application reads the environment directly — it all flows
# through backend/config.py, which is the one place to look for what a
# variable does.
# ============================================================================


# ----------------------------------------------------------------------------
# Core
# ----------------------------------------------------------------------------
# development | production. Production tightens several defaults: secure
# cookies on, API docs off, user-triggered pipeline runs off, and a missing
# SECRET_KEY becomes a hard startup failure instead of a generated one.
ENVIRONMENT=development

APP_NAME=Helix

# Where the browser reaches the app. Every link in every email and every OAuth
# redirect is built from this — set it to your real domain in production or
# users will receive localhost links.
PUBLIC_URL=http://localhost:5173

# Where the API is reachable. In production, when the backend serves the built
# frontend from the same origin, this is the same value as PUBLIC_URL.
API_URL=http://localhost:8000

# Comma-separated allowed browser origins. Leave blank to allow the Vite dev
# server plus PUBLIC_URL, which is right for both local dev and a
# single-origin production deployment.
# CORS_ORIGINS=https://helix.example.com


# ----------------------------------------------------------------------------
# Security  (REQUIRED in production)
# ----------------------------------------------------------------------------
# Signs access tokens and OAuth state. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# In development one is generated per boot, which means restarting the server
# signs everyone out — fine locally, unacceptable in production.
SECRET_KEY=

ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_TOKEN_TTL_HOURS=24

# Defaults follow ENVIRONMENT. Only set these if you have a specific reason —
# COOKIE_SECURE=true over plain http will silently break sign-in.
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.com


# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
# Defaults to SQLite at data/app.db. The data layer is dialect-agnostic, so
# moving to PostgreSQL is this one line (plus `pip install "psycopg[binary]"`).
# DATABASE_URL=postgresql+psycopg://helix:password@localhost:5432/helix


# ----------------------------------------------------------------------------
# Email
# ----------------------------------------------------------------------------
# console | smtp | resend | sendgrid | mailgun | ses
#
# 'console' writes fully rendered emails to data/outbox/ instead of sending
# them — open the .html files in a browser. That makes signup, verification,
# password reset and digests fully testable offline with no account anywhere.
EMAIL_PROVIDER=console

EMAIL_FROM=Helix <no-reply@helix.local>
# EMAIL_REPLY_TO=support@example.com

# --- Resend ---
# RESEND_API_KEY=re_...

# --- SendGrid ---
# SENDGRID_API_KEY=SG....

# --- Mailgun ---
# MAILGUN_API_KEY=...
# MAILGUN_DOMAIN=mg.example.com

# --- Amazon SES (needs `pip install boto3`; or use SMTP with SES credentials) ---
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- SMTP (Gmail, Postmark, Mailtrap, SES SMTP, ...) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true


# ----------------------------------------------------------------------------
# OAuth  (optional — providers without credentials are hidden from the UI)
# ----------------------------------------------------------------------------
# Register each app's callback URL as:  <API_URL>/api/auth/oauth/<provider>/callback
# e.g. http://localhost:8000/api/auth/oauth/google/callback

# https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# https://github.com/settings/developers
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# https://www.linkedin.com/developers/apps — enable "Sign In with LinkedIn
# using OpenID Connect" on the product tab.
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=


# ----------------------------------------------------------------------------
# Feature flags
# ----------------------------------------------------------------------------
# Let signed-in users trigger a discovery run from the UI. The pipeline is
# shared infrastructure, so this defaults off in production (admins can still
# trigger it) and on in development.
# ALLOW_USER_TRIGGERED_RUNS=true

# Require a confirmed email before sign-in is allowed. Off by default so a new
# user isn't blocked by a misconfigured mail provider.
# REQUIRE_EMAIL_VERIFICATION=false

# Turn off public signups (existing users can still sign in).
# SIGNUP_ENABLED=true


# ----------------------------------------------------------------------------
# Discovery pipeline  (unchanged from earlier versions)
# ----------------------------------------------------------------------------
# Web-search discovery uses a LOCAL, self-hosted SearXNG instance (see
# docker-compose.yml) — no API key, no public instances, no billing. Its
# address defaults to http://localhost:8080 via
# config.yaml -> sources.searxng_search.base_url.
# SEARXNG_BASE_URL=http://localhost:8080

# GitHub personal access token (optional but recommended — raises the search
# API rate limit). Create at https://github.com/settings/tokens (no scopes
# needed for public search).
GITHUB_TOKEN=


# ----------------------------------------------------------------------------
# Frontend build-time variable (frontend/.env or Vercel project settings)
# ----------------------------------------------------------------------------
# Absolute URL of the API. Read at BUILD time by Vite, so changing it needs a
# redeploy, not a restart. Leave unset locally — the Vite dev proxy handles it.
# VITE_API_URL=https://helix-api.up.railway.app


# ----------------------------------------------------------------------------
# Scheduler (daily / weekly recommendation emails)
# ----------------------------------------------------------------------------
# Runs the digest sends from inside the API process, so recommendation emails
# work without configuring a cron job. Sends are claimed through the database,
# so a redeploy can't double-send and multiple replicas can't either.
# Set false once a real scheduled job runs backend/workers/digest_worker.py.
# ENABLE_SCHEDULER=true
# SCHEDULER_HOUR=8        # UTC hour for the daily send
# SCHEDULER_WEEKDAY=0     # 0 = Monday, for the weekly send

# Also admit Vercel preview deployments, whose hostnames carry a build hash.
# CORS_ORIGIN_REGEX=^https://helix-ai-app-[a-z0-9-]+\.vercel\.app$
