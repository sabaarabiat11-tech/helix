# Production API origin, baked into the bundle at build time by Vite.
#
# Committed on purpose: it is a public URL, not a secret — anyone can read it
# from the shipped JavaScript regardless. Having it in the repo means a
# one-click Vercel import builds against the right backend with no dashboard
# configuration, which is the difference between "deploys" and "deploys and
# actually works".
#
# Vercel's own VITE_API_URL environment variable, if set, overrides this.
VITE_API_URL=https://helix-production-c193.up.railway.app
